# Bro-English — biến môi trường cho docker-compose.deploy.yml trên VPS
# Trên server: cp .env.deploy.example /opt/broenglish/.env && chỉnh giá trị (KHÔNG commit .env)
# Danh sách đầy đủ xem ENV_SETUP.md.

MONGODB_URI=
GEMINI_API_KEY=

